# Copy this file to .env and adjust values before running `docker compose up`

# Postgres
DB_NAME=habit_tracker
DB_USER=habit_tracker
# Jake vrijednosti: openssl rand -hex 24 (compose se bez njih ne pokreće).
DB_PASSWORD=
DB_PORT=5430

# Backend
BACKEND_PORT=8030
# openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3030

# Frontend
FRONTEND_PORT=3030
