# Copy this file to .env and adjust values before running `docker compose up`

# Postgres
DB_NAME=habit_tracker
DB_USER=habit_tracker
DB_PASSWORD=habit_tracker
DB_PORT=5432

# Backend
BACKEND_PORT=8080
JWT_SECRET=change-this-super-secret-key-in-production-please-32bytes-min
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend
FRONTEND_PORT=3000
